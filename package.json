{
  "name": "lyceum",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "workspaces": [
    "web",
    "api"
  ],
  "description": "Lyceum: a lecturer's workspace for reviewing course outcomes and topics, preparing teaching, and documenting advisory decisions.",
  "author": "Hafiz Azman",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "concurrently -n web,api -c blue,green \"npm run dev -w web\" \"npm run dev -w api\"",
    "start": "docker compose up -d --wait && npm run dev",
    "booth": "npm run build -w web && concurrently -n web,api -c blue,green \"npm run booth -w web\" \"npm start -w api\"",
    "dev:web": "npm run dev -w web",
    "dev:api": "npm run dev -w api",
    "build": "npm run build -w web",
    "preview": "npm run preview -w web",
    "typecheck": "tsc --noEmit",
    "prove": "node tests/prove-acceptance.ts",
    "prove:backtest": "node tests/prove-backtest.ts",
    "prove:flow": "node tests/prove-flow.ts",
    "prove:signal": "node tests/prove-signal.ts",
    "prove:intake": "node tests/prove-intake.ts",
    "prove:integrity": "node --test tests/prove-integrity.ts",
    "prove:compliance": "node --test tests/prove-compliance.ts",
    "prove:all": "node tests/prove-acceptance.ts && node tests/prove-backtest.ts && node tests/prove-flow.ts && node tests/prove-signal.ts && node tests/prove-intake.ts && node --test tests/prove-integrity.ts && node --test tests/prove-teaching.ts && node --test tests/prove-curriculum.ts && node --test tests/prove-evidence.ts && node --test tests/prove-collect.ts && node --test tests/prove-research.ts && node --test tests/prove-slides.ts && node --test tests/prove-benchmark.ts && node --test tests/prove-journey.ts && node --test tests/prove-snapshots.ts && node --test tests/prove-moods.ts && node --test tests/prove-mcp.ts && node --test tests/prove-course-record.ts && node --test tests/prove-materials.ts && node --test tests/prove-diff.ts && node --test tests/prove-judge.ts && node --test tests/prove-surveys.ts && node --test tests/prove-attainment.ts && node --test tests/prove-items.ts && node --test tests/prove-watch.ts && node --test tests/prove-account.ts && node --test tests/prove-record.ts && node --test tests/prove-storage.ts && node --test tests/prove-compliance.ts",
    "gen:demo": "node scripts/gen-demo-files.mjs",
    "gen:music": "node scripts/gen-music.mjs",
    "smoke": "node scripts/demo-smoke.mjs",
    "smoke:integrity": "node scripts/integrity-smoke.mjs",
    "shots": "node scripts/presentation-shots.mjs",
    "prove:teaching": "node --test tests/prove-teaching.ts",
    "smoke:workspace": "node scripts/workspace-smoke.mjs",
    "prove:curriculum": "node --test tests/prove-curriculum.ts",
    "prove:evidence": "node --test tests/prove-evidence.ts",
    "prove:collect": "node --test tests/prove-collect.ts",
    "prove:research": "node --test tests/prove-research.ts",
    "prove:slides": "node --test tests/prove-slides.ts",
    "prove:benchmark": "node --test tests/prove-benchmark.ts",
    "prove:journey": "node --test tests/prove-journey.ts",
    "prove:snapshots": "node --test tests/prove-snapshots.ts",
    "gen:sample": "node scripts/gen-collected-sample.mjs",
    "smoke:curriculum": "node scripts/curriculum-smoke.mjs",
    "gen:theme": "node scripts/gen-theme-css.mjs",
    "check:contrast": "node scripts/contrast-check.mjs",
    "check:dashes": "node scripts/dash-scan.mjs",
    "prove:moods": "node --test tests/prove-moods.ts",
    "prove:mcp": "node --test tests/prove-mcp.ts",
    "prove:course-record": "node --test tests/prove-course-record.ts",
    "prove:materials": "node --test tests/prove-materials.ts",
    "prove:diff": "node --test tests/prove-diff.ts",
    "prove:judge": "node --test tests/prove-judge.ts",
    "prove:surveys": "node --test tests/prove-surveys.ts",
    "prove:attainment": "node --test tests/prove-attainment.ts",
    "prove:items": "node --test tests/prove-items.ts",
    "prove:agent-search": "node --test tests/prove-agent-search.ts",
    "prove:outline": "node --test tests/prove-outline.ts",
    "prove:storage": "node --test tests/prove-storage.ts && node --test tests/prove-compliance.ts",
    "prove:watch": "node --test tests/prove-watch.ts",
    "search:up": "docker compose up -d searxng",
    "services:down": "docker compose down",
    "db:up": "supabase start",
    "mcp": "node mcp/server.ts",
    "mcp:sample": "node mcp/sample.ts",
    "mcp:try": "node mcp/try.ts",
    "deck": "node scripts/gen-deck.mjs",
    "deck:check": "node scripts/gen-deck.mjs --check",
    "gen:architecture": "node scripts/gen-architecture.mjs",
    "gen:brief": "node scripts/gen-brief-pdf.mjs",
    "gen:poster": "node scripts/gen-poster.mjs",
    "gen:sample-decks": "node scripts/gen-sample-decks.mjs",
    "gen:partner-marks": "node scripts/gen-partner-marks.mjs",
    "gen:partner-logos": "node scripts/gen-partner-logos.mjs",
    "db:down": "supabase stop",
    "db:reset": "supabase db reset",
    "db:push": "supabase db push",
    "prove:account": "node --test tests/prove-account.ts",
    "prove:record": "node --test tests/prove-record.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1159.0",
    "@hono/node-server": "^2.1.5",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@supabase/supabase-js": "^2.118.0",
    "hono": "^4.13.13",
    "jszip": "^3.10.2",
    "lucide-react": "^1.61.0",
    "lz-string": "^1.5.0",
    "pg": "^8.23.1",
    "pptxgenjs": "^4.0.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "unpdf": "^1.9.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.12",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "puppeteer-core": "^25.15.0",
    "simple-icons": "^16.35.0",
    "supabase": "^2.122.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "overrides": {
    "image-size": "^2.0.4"
  }
}
