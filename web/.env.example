# The frontend's settings (web/). Copy to web/.env: cp web/.env.example web/.env
# Where the dev server and the booth's preview forward /api. Match PORT in api/.env.
API_PORT=8787

# ---------- Supabase, read by the browser ----------
# Vite exposes only VITE_ variables to the page, and everything here is public by design. Never put a secret key here.
# Local: npm run db:up, then npx supabase status prints both. Cloud: Supabase dashboard, Project Settings, API Keys.
# cloud: https://<project-ref>.supabase.co
VITE_SUPABASE_URL=http://127.0.0.1:54321
# sb_publishable_...
VITE_SUPABASE_PUBLISHABLE_KEY=
