# The API's settings (api/). Copy to api/.env and fill in to enable live agents: cp api/.env.example api/.env
# Without a model, local interpretation and illustrative fixtures remain available.
# The API's port. The web dev server proxies /api here; set API_PORT in web/.env to match if you change it.
PORT=8787

# ---------- The model, for every agent (intake, authoring, evaluator, analogy, signal, outline reader, web search) ----------
# Read again on every request, so editing these switches provider without a restart.
# Model: any OpenAI-compatible chat API with tool calling.
# Provider names fill in the base URL: openai, openrouter, gemini, groq, ollama. Use custom with a base URL for anything else.
LYCEUM_AGENT_PROVIDER=openrouter
# Only needed for custom, or to override a provider's default address (e.g. http://localhost:1234/v1).
LYCEUM_AGENT_BASE_URL=
# The model id exactly as your provider lists it. Pick one that supports tool calling.
LYCEUM_AGENT_MODEL=
# Not needed for ollama.
LYCEUM_AGENT_API_KEY=
# Optional: a separate, fast model for reading course outlines at onboarding (Folio), where the lecturer waits on it.
# Unset, the model above reads them; if this one fails (a free tier's rate limit), the model above is tried instead.
LYCEUM_OUTLINE_BASE_URL=
LYCEUM_OUTLINE_MODEL=
LYCEUM_OUTLINE_API_KEY=
# Web search, as Odysseus does it: a first provider, then a fallback chain tried in order when one fails or finds nothing.
# searxng, duckduckgo, tavily, brave, serper or google. With nothing set: searxng, then duckduckgo, so no key is needed.
LYCEUM_SEARCH_PROVIDER=searxng
LYCEUM_SEARCH_FALLBACK=duckduckgo
# Default window for searches the agent does not date itself: day, week, month, year, or any.
LYCEUM_SEARCH_TIME=month
# SearXNG's address. npm run search:up starts one here (docker-compose.yml, Docker needed).
SEARXNG_URL=http://localhost:8080
# Keyed providers, each with its own key; one without its key is skipped in the chain.
#https://app.tavily.com/home
TAVILY_API_KEY=
BRAVE_API_KEY=
SERPER_API_KEY=
GOOGLE_PSE_KEY=
GOOGLE_PSE_CX=
# Per-run limits: model turns (2 to 40) and postings kept (1 to 50).
LYCEUM_AGENT_MAX_STEPS=12
LYCEUM_AGENT_MAX_POSTINGS=20

# ---------- Uploaded files: Cloudflare R2 (api/storage.ts) ----------
# A signed-in account's uploads (outlines, results, slides) are kept, so a file can be read again later. Leave these
# empty and nothing is stored. Cloudflare dashboard: R2 > Create bucket (e.g. lyceum-prod), then R2 > Manage API tokens >
# Create API token, Object Read & Write, that bucket only. S3_ENDPOINT is https://<account id>.r2.cloudflarestorage.com.
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=

# ---------- Watching on a schedule (Watch > Watch on a schedule; api/watch.ts) ----------
# The API checks for due schedules every 15 minutes. Set to off to stop it (the Run now button still works).
LYCEUM_WATCH=on

# ---------- Supabase: accounts, profiles, workspaces, scheduled Watch ----------
# Local: npm run db:up (Supabase CLI, Docker needed), then npx supabase status prints the values. npm run db:reset applies
# supabase/migrations/ to it. Cloud: Supabase dashboard, Project Settings, API Keys; and Connect, Session pooler for the
# database. npm run db:push applies supabase/migrations/ to the cloud project.
# SECRET: the API only. Never copy SUPABASE_SECRET_KEY into web/.env or give it a VITE_ prefix.
# the same project as VITE_SUPABASE_URL in web/.env
SUPABASE_URL=http://127.0.0.1:54321
# sb_secret_...
SUPABASE_SECRET_KEY=
# Local default below. Cloud: the Session pooler string, without ?sslmode= (TLS is verified with supabase/ca.crt).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# 1 to make the model, search, settings and parse routes answer signed-in people only (for a server online).
LYCEUM_REQUIRE_SIGN_IN=
# 1 for a server online that answers everyone (Render without sign-in): requests from other machines are then allowed.
# Left empty, the API answers only the laptop it runs on (and the phones' survey routes).
LYCEUM_ONLINE=

# ---------- The address people open Lyceum at ----------
# Google sign-in is switched on in Supabase (dashboard: Authentication, Sign In / Providers; or supabase/config.toml), not
# here. Add this address to Supabase's allowed redirect URLs.
APP_URL=http://localhost:5173
