# Copy to .env and fill in to enable live agents.
# Without a model, local interpretation and illustrative fixtures remain available.
# Server port (the Vite dev server proxies /api here).
PORT=8787

# ---------- The model, for every agent (intake, authoring, evaluator, analogy, signal, outline reader, web search) ----------
# Read again on every request, so editing these switches provider without a restart.
# Model: any OpenAI-compatible chat API with tool calling.
# Provider names fill in the base URL: openai, openrouter, gemini, groq, ollama. Use custom with a base URL for anything else.
LYCEUM_AGENT_PROVIDER=openrouter
# Only needed for custom, or to override a provider's default address (e.g. http://localhost:1234/v1).
LYCEUM_AGENT_BASE_URL=
# The model id exactly as your provider lists it. Pick one that supports tool calling.
LYCEUM_AGENT_MODEL=
# Not needed for ollama.
LYCEUM_AGENT_API_KEY=
# Web search, as Odysseus does it: a first provider, then a fallback chain tried in order when one fails or finds nothing.
# searxng, duckduckgo, tavily, brave, serper or google. With nothing set: searxng, then duckduckgo, so no key is needed.
LYCEUM_SEARCH_PROVIDER=searxng
LYCEUM_SEARCH_FALLBACK=duckduckgo
# Default window for searches the agent does not date itself: day, week, month, year, or any.
LYCEUM_SEARCH_TIME=month
# SearXNG's address. npm run search:up starts one here (docker-compose.yml, Docker needed).
SEARXNG_URL=http://localhost:8080
# Keyed providers, each with its own key; one without its key is skipped in the chain.
#https://app.tavily.com/home
TAVILY_API_KEY=
BRAVE_API_KEY=
SERPER_API_KEY=
GOOGLE_PSE_KEY=
GOOGLE_PSE_CX=
# Per-run limits: model turns (2 to 40) and postings kept (1 to 50).
LYCEUM_AGENT_MAX_STEPS=12
LYCEUM_AGENT_MAX_POSTINGS=20

# ---------- Watching on a schedule (Watch > Watch on a schedule; server/watch.ts) ----------
# The API checks for due schedules every 15 minutes. Set to off to stop it (the Run now button still works).
LYCEUM_WATCH=on

# ---------- The database (accounts, sessions, workspaces) ----------
# PostgreSQL. npm run db:up starts one in Docker with these defaults (docker-compose.yml); change all four together.
DATABASE_URL=postgres://lyceum:lyceum@localhost:5432/lyceum
POSTGRES_USER=lyceum
POSTGRES_PASSWORD=lyceum
POSTGRES_DB=lyceum

# ---------- Accounts ----------
# Email and password accounts work with nothing set. For "Continue with Google", create an OAuth client (Web application)
# in Google Cloud Console with the redirect URI APP_URL + /api/auth/google/callback, exactly, e.g.
# http://localhost:5173/api/auth/google/callback (localhost, not 127.0.0.1). See docs/GOOGLE_AUTH_PORTABLE.md, section 3.
APP_URL=http://localhost:5173
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
