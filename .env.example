# Docker services only (docker-compose.yml: Postgres and SearXNG). Copy to .env at the repo root: cp .env.example .env
# Everything here has a default, so this file is optional. The app's own settings live in api/.env and web/.env.
# If you change the Postgres values, change DATABASE_URL in api/.env to match.
POSTGRES_USER=lyceum
POSTGRES_PASSWORD=lyceum
POSTGRES_DB=lyceum
SEARXNG_SECRET=lyceum-local-only-change-me
