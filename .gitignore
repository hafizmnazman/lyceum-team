# Published as .gitignore in the team repo.
node_modules/
dist/
# Regenerated, not committed: the deck's exports and film, and the film's footage, timeline and renders.
deck/export/
deck/media/*.mp4
video/remotion/node_modules/
video/remotion/public/
video/remotion/src/generated/
video/out/
video/install.log
.env
# Google OAuth client downloads (Download JSON in Google Cloud Console): they hold the client secret.
client_secret_*.json
# Accounts, sessions and workspaces (server/auth.ts).
data/
# SearXNG writes its own files next to settings.yml; only settings.yml is ours.
searxng/*
!searxng/settings.yml
.env.*
!.env.example
*.local
*.log
*.pem
*.key
.DS_Store
Thumbs.db
.vscode/
.idea/
.claude/settings.local.json
